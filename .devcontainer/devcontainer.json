{
  "name": "container-execution-guardrail",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--cap-drop=ALL", 
    "--security-opt=no-new-privileges:true"
  ],
  // Additional settings can be added here
  "remoteUser": "node",
  "containerEnv": {
    "IS_CONTAINER": "false"
  }
}